							<ProtectedString name="Source"><![CDATA[local Root = script:FindFirstAncestorWhichIsA("Tool") -- alright i'm sleepy i'm doing that instead
local Vendor = Root:WaitForChild('Vendor')

-- Libraries
local Roact = require(Vendor:WaitForChild('Roact'))

-- Roact
local new = function(Type, props, ...)
	props["RBXTAG_FORK3X_Component"] = true

	return Roact.createElement(Type, props, ...)
end

local function BuildInterface(Environment)	
	local props = Environment.props

	return new('TextLabel', {
		AnchorPoint = Vector2.new(0.5, 0.5);
		BackgroundTransparency = 1;
		Size = UDim2.new(0, 420, 0, 300);
		Text = [[<font weight="800"><u>FORK</u><br/>3X</font>]];
		TextStrokeTransparency = 1;
		TextTransparency = 0.9;
		TextScaled = true;
		RichText = true;
		TextColor3 = props.ThemeColor;
		Font = Enum.Font.MontserratBlack;
		Position = UDim2.new(0.5, 0, 0.5, 0);
		ZIndex = 0;
			--[[
			[Roact.Ref] = function(rbx)
				coroutine.wrap(function()
					if rbx then
						rbx.Parent = rbx.Parent:WaitForChild("Content")
					end
				end)()
			end,]]
	});
end

return BuildInterface

]]></ProtectedString>
