					<Item class="ModuleScript" referent="RBXF9DBCF2151B14E12949662FE488BE0A9">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local Component = {}

local ChangedTexts = {}

function Component.Apply(Object, Core)
	ChangedTexts[Object] = Object.Text
	Object.Text = string.upper(Object.Text)
end

function Component.Revert(Core)
	for Object, InitialText in ChangedTexts do
		if Object then
			Object.Text = InitialText
		end
	end
	table.clear(ChangedTexts)
end


return Component
]]></ProtectedString>
